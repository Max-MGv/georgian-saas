generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PlatformConfig {
  id        String   @id @default("platform")
  logoUrl   String?
  logoAlt   String?
  updatedAt DateTime @updatedAt
}

model Tenant {
  id          String   @id @default(cuid())
  name        String
  domain      String   @unique
  slug        String   @unique
  theme       Json?
  logoUrl     String?
  logoAlt     String?
  faviconUrl  String?
  displayName String?
  createdAt   DateTime @default(now())
}

model Company {
  id                 String       @id @default(cuid())
  name               String
  identificationCode String?
  contactName        String?
  contactPhone       String?
  contactEmail       String?
  address            String?
  accessCode         String?
  isIndividual       Boolean      @default(false)
  isBookingCompany   Boolean      @default(true)
  isWineOrderCompany Boolean      @default(false)
  tenantId           String?
  createdAt          DateTime     @default(now())
  orders             Order[]
  wineOrders         WineOrder[]
  prices             Price[]
}

model Order {
  id                String             @id @default(cuid())
  status            OrderStatus        @default(NEW)
  bookingType       BookingType        @default(INDIVIDUAL)
  visitType         VisitType
  date              DateTime
  timeSlot          String
  guestCount        Int
  // Enhanced guest counts (v1.2) — 0 means not set (pre-enhancement order)
  lunchGuestCount   Int                @default(0)
  tastingGuestCount Int                @default(0)
  freeGuestCount    Int                @default(0)
  // Hot dish selections (v1.2)
  hotDishVegetable  String?
  hotDishMeat       String?
  foodNotes         String?
  name              String
  surname           String
  email             String?
  phone             String?
  notes             String?
  totalPrice        Float?
  tenantId          String?
  companyId         String?
  company           Company?           @relation(fields: [companyId], references: [id])
  createdAt         DateTime           @default(now())
  masterclassLines  OrderMasterclass[]
  extras            OrderExtra[]
}

model Price {
  id                         String  @id @default(cuid())
  companyId                  String
  company                    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  minGuests                  Int
  maxGuests                  Int
  pricePerPerson             Float
  tastingLunchPricePerPerson Float   @default(0)
  registrationPrice          Float   @default(0)
  isDisplayPrice             Boolean @default(false)
}

model MenuItem {
  id        String   @id @default(cuid())
  name      String
  type      String   // "VEGETABLE" | "MEAT"
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  tenantId  String?
  createdAt DateTime @default(now())
}

model MasterclassItem {
  id           String             @id @default(cuid())
  name         String
  unitType     MasterclassUnit    @default(PER_PIECE)
  pricePerUnit Float
  active       Boolean            @default(true)
  sortOrder    Int                @default(0)
  tenantId     String?
  createdAt    DateTime           @default(now())
  orderLines   OrderMasterclass[]
}

model OrderMasterclass {
  id                String          @id @default(cuid())
  orderId           String
  masterclassItemId String
  quantity          Int
  pricePerUnit      Float           // price snapshot at time of booking
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  masterclassItem   MasterclassItem @relation(fields: [masterclassItemId], references: [id])
}

model OrderExtra {
  id      String @id @default(cuid())
  orderId String
  label   String
  amount  Float
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model WineOrder {
  id              String   @id @default(cuid())
  businessName    String
  llcName         String?
  llcId           String?
  address         String
  workingHours    String?
  contactName     String
  contactPhone    String
  wines           Json
  totalAmount     Float?
  status          String   @default("pending")
  tenantId        String?
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id])
  createdAt       DateTime @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  key       String
  value     String
  tenantId  String?
  updatedAt DateTime @updatedAt

  @@unique([key, tenantId])
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String
  value     String
  section   String
  label     String
  locale    String   @default("en")
  tenantId  String?
  updatedAt DateTime @updatedAt

  @@unique([key, locale, tenantId])
}

model BlockedDate {
  id        String   @id @default(cuid())
  date      DateTime
  reason    String?
  tenantId  String?
  createdAt DateTime @default(now())

  @@unique([date, tenantId])
}

model Wine {
  id          String   @id @default(cuid())
  name        String
  type        String
  description String?
  price       Float
  color       String   @default("#7c1d23")
  imagePath   String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  tenantId    String?
  createdAt   DateTime @default(now())
}

enum OrderStatus {
  NEW
  CONFIRMED
  INVOICE_SENT
  PAID
  COMPLETED
  CANCELLED
}

enum BookingType {
  INDIVIDUAL
  COMPANY
}

enum VisitType {
  TASTING
  TASTING_LUNCH
}

enum MasterclassUnit {
  PER_PERSON  // multiplied by paying guest count automatically
  PER_PIECE   // admin enters quantity manually
  FLAT        // fixed price, no quantity
}
