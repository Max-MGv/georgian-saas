generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PlatformConfig {
  id        String   @id @default("platform")
  logoUrl   String?
  logoAlt   String?
  updatedAt DateTime @updatedAt
}

model Tenant {
  id                                String          @id @default(cuid())
  name                              String
  domain                            String          @unique
  slug                              String          @unique
  theme                             Json?
  logoUrl                           String?
  logoAlt                           String?
  faviconUrl                        String?
  displayName                       String?
  modulesBooking                    Boolean         @default(true)
  modulesWineOrders                 Boolean         @default(false)
  modulesPublicSite                 Boolean         @default(true)
  modulesLegalPages                 Boolean         @default(true)
  // Online payment (Flitt). Off by default so every existing tenant is
  // unaffected — the whole payment path is a no-op unless this is on AND
  // both credentials below are filled in.
  modulesOnlinePayment              Boolean         @default(false)
  // PRODUCT: wine-level type/sweetness/sparkling/alcohol shared across all vintages (today's behavior).
  // VINTAGE: those four live per-vintage instead, no fallback to the wine's value when unset.
  // Tenant-wide, super-admin only — see vault/Plan-WineVintageDetails.md.
  wineDetailLevel                   WineDetailLevel @default(PRODUCT)
  // Per-tenant Flitt merchant credentials. Deliberately NOT in `Setting`:
  // `getAllSettings()` returns that whole map and MaintenanceNotes §9 documents
  // the hazard of it reaching a client component. Keeping the secret here makes
  // that leak structurally impossible. Never return flittSecretKey to a browser.
  flittMerchantId                   String?
  flittSecretKey                    String?
  // Granular payment controls (#148). Independent per-section switches for
  // whether a tenant takes online payment at all in that section — separate
  // from modulesOnlinePayment (can the tenant take payment at all) and from
  // showCompanyPrice (a privacy setting, unrelated to payment intent — see
  // decision #5). All three default true so a tenant flipping modulesOnlinePayment
  // on for the first time gets today's "payment everywhere it's structurally
  // possible" behavior with no extra steps.
  paymentEnabledIndividuals         Boolean         @default(true)
  paymentEnabledCompanies           Boolean         @default(true)
  paymentEnabledWineOrders          Boolean         @default(true)
  // Company-booking nationality tagging (Plan-CompanyNationality). Super-admin only, like
  // wineDetailLevel above — never exposed in the tenant's own SettingsClient.tsx. Gates whether
  // BookingForm.tsx offers the nationality picker for COMPANY bookings; does not retroactively
  // hide nationalities already stored on existing orders when turned off.
  enableCompanyNationalityBreakdown Boolean         @default(false)
  createdAt                         DateTime        @default(now())
}

model Company {
  id                  String          @id @default(cuid())
  name                String
  identificationCode  String?
  address             String?
  // The company-level gate, distinct from a person's own code (CompanyPerson.code).
  // NOT governed by `person_codes_enabled` — it works in both modes, because it is the only
  // way the hide_company_dropdown variant can identify a company at all. Required server-side
  // whenever it is set: see lib/contactResolution.ts, and Plan-ContactRoles §9b A1 for the
  // audit that found it being enforced by the form alone.
  //
  // (This comment used to name a setting called `company_access_codes_enabled`. No such key
  // exists — it was renamed to `person_codes_enabled` in Chunk 3 precisely because it governs
  // people's codes, not the company's.)
  //
  // @unique is the first DB-level guarantee this code pool has ever had — uniqueness used to
  // be enforced only in generateUniqueTenantCode(), so a raw insert could silently collide
  // (MaintenanceNotes #26). Postgres treats NULLs as distinct, so the many code-less
  // companies are unaffected.
  accessCode          String?         @unique
  isIndividual        Boolean         @default(false)
  isBookingCompany    Boolean         @default(true)
  isWineOrderCompany  Boolean         @default(false)
  wineDiscountPercent Float?
  // Per-company override of the tenant's Companies section toggle (#148).
  // null = follow paymentEnabledCompanies; true = always skip (trusted,
  // reservation-only); false = always require (bounded by the hard blocks
  // in shouldTakePayment — cannot force payment through a missing price or
  // a module that's off). Applies to this company's bookings and wine
  // orders alike — see edge case notes in Feature 148 on why it isn't split per-module.
  skipPayment         Boolean?
  tenantId            String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @default(now()) @updatedAt
  orders              Order[]
  wineOrders          WineOrder[]
  prices              Price[]
  people              CompanyPerson[]

  @@index([tenantId])
}

/// A kind of contact a company can have — "Guide", "Contact Person", later "CEO".
///
/// A dimension table rather than an enum, because the requirement is that adding a type is an
/// admin action, not a migration (Max, 2026-09-19: *"it should be trivially easy, to in the
/// future add or remove types of contact data attached to an order"*). This does **not**
/// contradict vault/DataModel/Research-OrderStatusPatterns.md's "statuses stay enums" finding:
/// that rule is about a state machine code branches on. Nothing branches on "is this a guide" —
/// only on `scope`. Same split Magento makes between a fixed `state` and a customisable `status`.
///
/// Has its OWN tenantId, unlike CompanyPerson — a role belongs to the winery, not to one
/// company. So its RLS policy is a direct tenantId check, not a JOIN.
model ContactRole {
  id        String          @id @default(cuid())
  tenantId  String
  /// Stable machine key ('guide', 'contact_person'). Code matches on this; labels are display
  /// only, which is what makes renaming a system role safe.
  key       String
  labelEn   String
  labelKa   String
  scope     ContactScope
  appliesTo ContactApplies
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  /// Seeded roles. Renameable and deactivatable, never deletable — every CompanyPerson and
  /// OrderContact points at a role, so deleting one orphans live rows. Deactivating hides it
  /// from the pickers while leaving history readable, which is what an admin actually wants.
  isSystem  Boolean         @default(false)
  people    CompanyPerson[]
  contacts  OrderContact[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

/// PER_ORDER    — picked per booking/wine order, autofills the form, stored on OrderContact.
/// COMPANY_LEVEL — company data only. Never appears on a public form (Max's CEO example).
enum ContactScope {
  PER_ORDER
  COMPANY_LEVEL
}

enum ContactApplies {
  BOOKING
  WINE_ORDER
  BOTH
}

/// One person at one company, in one role. Replaces CompanyGuide, CompanyRepresentative **and**
/// Company.contactName/contactPhone/contactEmail — the three concepts Max identified as "1
/// extra" on 2026-09-19.
///
/// No own tenantId — RLS is JOIN-to-Company, the same shape as Price.
model CompanyPerson {
  id        String         @id @default(cuid())
  companyId String
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roleId    String
  /// Restrict, not Cascade: deleting a role must not silently delete the people in it. The
  /// admin UI deactivates roles instead of deleting them, so this should never fire — it is
  /// here so that if it ever does, it fails loudly rather than removing data.
  role      ContactRole    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  name      String
  phone     String?
  email     String?
  /// Null when the tenant has `person_codes_enabled` off and none was ever generated.
  /// Unique per tenant across Company.accessCode too — enforced in generateUniqueTenantCode(),
  /// and by the partial index this migration adds (the first DB-level guarantee this pool has
  /// ever had; see MaintenanceNotes #26 for the five days it went unenforced).
  code      String?        @unique
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  contacts  OrderContact[]

  @@index([companyId, roleId])
}

/// Who was on THIS order, in which role, and what their details were **at the time**.
///
/// Polymorphic over Order/WineOrder like OrderEvent and Payment, rather than two parallel
/// tables — reusing a convention already in the schema beats inventing a third.
///
/// The snapshots are the point. `Order.guideId` (which this replaces) was an optional relation
/// with no onDelete, so Prisma defaulted it to SetNull: deleting a guide silently erased which
/// guide was on every past order, with no warning (KnownBugs #56). Here personId may go null
/// and nothing is lost, because the facts live on this row. Same rule as
/// WineOrderItem.priceSnapshot and Order's rate snapshots — a fact must not move when a
/// dimension changes.
model OrderContact {
  id            String         @id @default(cuid())
  tenantId      String?
  /// Exactly one of these is set. Cascade — a contact whose order is gone is unreadable.
  orderId       String?
  order         Order?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  wineOrderId   String?
  wineOrder     WineOrder?     @relation(fields: [wineOrderId], references: [id], onDelete: Cascade)
  roleId        String
  role          ContactRole    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  /// SetNull is correct here, unlike Order.guideId — see the snapshot note above.
  personId      String?
  person        CompanyPerson? @relation(fields: [personId], references: [id], onDelete: SetNull)
  nameSnapshot  String
  phoneSnapshot String?
  emailSnapshot String?
  createdAt     DateTime       @default(now())

  /// One person per role per order (Max, 2026-09-19). Postgres treats NULLs as distinct, so
  /// wine-order rows (orderId null) never collide with each other under the first index, and
  /// booking rows never collide under the second.
  @@unique([orderId, roleId])
  @@unique([wineOrderId, roleId])
  @@index([tenantId, orderId])
  @@index([tenantId, wineOrderId])
}

model Order {
  id                      String             @id @default(cuid())
  // Where the booking is, and nothing about money (Feature 191). Its own enum
  // rather than one shared with WineOrder, so a booking is structurally
  // incapable of holding the wine-only DELIVERED — which the previous shared
  // reference table could not prevent: its `appliesTo` column filtered the
  // dropdown, never the foreign key.
  stage                   BookingStage       @default(NEW)
  // Milestones as dates, not as a status ladder. The ladder was the bug: it
  // was `unpaid → invoiced → paid`, so marking an invoiced order paid erased
  // the fact that an invoice had ever been sent. Independent dates cannot
  // overwrite each other — invoiced on the 3rd and paid on the 19th are both
  // permanently true — and they also make "did they pay before or after the
  // visit" answerable by comparison rather than by a stored flag.
  //
  // They are also what places the Paid step on the flow-line. That used to be
  // `paidAtStage`, a snapshotted code string; a timestamp cannot go stale the
  // way a snapshot of a since-renamed status could.
  confirmedAt             DateTime?
  completedAt             DateTime?
  invoiceSentAt           DateTime?
  paidAt                  DateTime?
  // Set when the guest is sent to the card gateway, cleared the moment the
  // order completes. So it reads literally: this order has been incomplete
  // since <date>. Replaces the three legacy limbo values (PENDING_PAYMENT,
  // pending_payment, payment_failed) with one fact — Max's call: a closed tab
  // and a declined card are the same thing to the winery, an order that never
  // happened. Abandoned orders are excluded from every order surface and live
  // on their own screen; see MaintenanceNotes.
  abandonedAt             DateTime?
  bookingType             BookingType        @default(INDIVIDUAL)
  visitType               VisitType
  date                    DateTime
  timeSlot                String
  guestCount              Int
  // Enhanced guest counts (v1.2) — 0 means not set (pre-enhancement order)
  lunchGuestCount         Int                @default(0)
  tastingGuestCount       Int                @default(0)
  freeGuestCount          Int                @default(0)
  // Hot dish selections (v1.2)
  hotDishVegetable        String?
  hotDishMeat             String?
  foodNotes               String?
  name                    String
  surname                 String
  email                   String?
  phone                   String?
  notes                   String?
  totalPrice              Int?
  tenantId                String?
  companyId               String?
  // Set only when bookingType is COMPANY and companyId is null — a booking
  // submitted through the "New Company?" flow, before the winery has created
  // a real Company row. Display-only (admin Orders table + emails); never
  // used for pricing or access-code lookups. See Feature 180.
  requestedCompanyName    String?
  company                 Company?           @relation(fields: [companyId], references: [id])
  // Who was on this booking, by role — the guide to call during the visit, the contact person
  // to invoice. Replaces the old single `guideId` column, which nothing ever read and which
  // silently nulled itself when a guide was deleted (KnownBugs #56).
  //
  // ⚠️ The Contact Person's details are ALSO written to name/surname/phone/email above. That
  // is deliberate and is the one special case in this design (Plan-ContactRoles decision 4):
  // those columns are non-nullable and are the only place an INDIVIDUAL booking's guest name
  // lives, so they cannot be repurposed. `contacts` is the source of truth; they are a
  // denormalised copy, written in exactly one place — createBooking.ts.
  contacts                OrderContact[]
  // ISO 3166-1 alpha-2 codes, COMPANY bookings only (Plan-CompanyNationality). No per-country
  // counts — "at most a mix" per Max, not a headcount breakdown. Plain array on the already
  // tenant-scoped Order row, so it needs no new RLS policy/grant of its own.
  nationalities           String[]           @default([])
  // Rate snapshots, in TETRI (chunk 4, 2026-09-18). Taken at booking time from
  // whichever tier priced the order, or from the rates an admin typed when
  // there is no tier.
  //
  // They exist because `recalcOrderTotal` used to re-read the company's *live*
  // Price rows: change a company's rates in March, add a 20 GEL extra to their
  // February booking, and the whole booking silently re-priced at March rates.
  // A fact must not move when a dimension changes — the same reason
  // OrderMasterclass.pricePerUnit and WineOrderItem.priceSnapshot exist. This
  // makes bookings consistent with those rather than inventing anything.
  //
  // Nullable only for orders created before this column existed; recalc falls
  // back to the old live-tier lookup for those and logs when it does.
  //
  // registrationFeeSnapshot is 0 for individuals: that path never applied the
  // tier's registration fee, and the snapshot records what was *used*, not what
  // the tier happened to hold.
  tastingRateSnapshot     Int?
  lunchRateSnapshot       Int?
  registrationFeeSnapshot Int?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @default(now()) @updatedAt
  masterclassLines        OrderMasterclass[]
  extras                  OrderExtra[]
  payments                Payment[]
  orderEvents             OrderEvent[]

  // Every query here is tenant-scoped by RLS, and the admin list/calendar both
  // filter-and-order by date while the board and its filter pills group by
  // stage. Without a tenantId-leading index these are sequential scans across
  // every tenant's rows at once.
  @@index([tenantId, date])
  @@index([tenantId, stage])
  // Every order surface filters out abandoned rows, so this is on the hot path
  // of the list, board, calendar, counts and export alike.
  @@index([tenantId, abandonedAt])
}

/// One thing that happened to an order. Append-only: never updated, never deleted.
///
/// Added 2026-09-18 (chunk 5 of vault/DataModel/Plan-DataModel.md). Every mature
/// commerce platform has this table — Saleor calls it `OrderEvent`, Magento
/// `sales_order_status_history` — and this project did not. The concrete gap it
/// closes was already logged as open in Plan-StatusModel.md: un-paying an order
/// by hand left no trace at all, because a manual payment has no `Payment` row
/// to survive as the record.
///
/// It does NOT replace the milestone columns. `paidAt` and friends stay as the
/// current state, read on every board render; this is history, read when someone
/// asks a question. Deriving state by replaying events would be event sourcing,
/// which is genuinely over-complicated here.
///
/// Shape follows `Payment`: nullable `orderId`/`wineOrderId` with exactly one
/// set, rather than a second polymorphic convention. Reusing a pattern already
/// in the schema beats inventing one.
model OrderEvent {
  id          String         @id @default(cuid())
  tenantId    String?
  /// Exactly one of these is set. Cascade, so history goes with the order it
  /// describes — an event whose order no longer exists is unreadable anyway.
  orderId     String?
  order       Order?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  wineOrderId String?
  wineOrder   WineOrder?     @relation(fields: [wineOrderId], references: [id], onDelete: Cascade)
  type        OrderEventType
  actorType   ActorType
  /// The Supabase user id for an ADMIN action. Null for GUEST/SYSTEM/GATEWAY,
  /// which have no user behind them.
  actorId     String?
  /// Only meaningful on STAGE_CHANGED. Plain strings rather than the enums,
  /// because a stage that is later renamed must not make old history invalid.
  fromStage   String?
  toStage     String?
  /// Anything type-specific: an amount, an extra's label, a gateway status.
  payload     Json?
  occurredAt  DateTime       @default(now())

  @@index([tenantId, orderId, occurredAt])
  @@index([tenantId, wineOrderId, occurredAt])
}

enum OrderEventType {
  CREATED
  STAGE_CHANGED
  PAID
  UNPAID
  INVOICE_SENT
  INVOICE_UNSENT
  RESTORED
  ABANDONED
  PAYMENT_DECLINED
  EXTRA_ADDED
  EXTRA_REMOVED
}

enum ActorType {
  GUEST
  ADMIN
  SYSTEM
  GATEWAY
}

model Price {
  id                         String   @id @default(cuid())
  companyId                  String
  company                    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  minGuests                  Int
  maxGuests                  Int
  pricePerPerson             Int
  tastingLunchPricePerPerson Int      @default(0)
  registrationPrice          Int      @default(0)
  isDisplayPrice             Boolean  @default(false)
  // Pricing is edited in place, so without these there is no record of when a
  // company's rates changed — and every booking is priced from them. Chunk 4
  // will additionally snapshot the tier onto the Order, which is what stops
  // recalcOrderTotal repricing old bookings at today's rates.
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @default(now()) @updatedAt
}

model MenuItem {
  id        String   @id @default(cuid())
  name      String
  type      String // "VEGETABLE" | "MEAT"
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  tenantId  String?
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model MasterclassItem {
  id           String             @id @default(cuid())
  name         String
  unitType     MasterclassUnit    @default(PER_PIECE)
  pricePerUnit Int
  active       Boolean            @default(true)
  sortOrder    Int                @default(0)
  tenantId     String?
  createdAt    DateTime           @default(now())
  orderLines   OrderMasterclass[]

  @@index([tenantId])
}

model OrderMasterclass {
  id                String          @id @default(cuid())
  orderId           String
  masterclassItemId String
  quantity          Int
  pricePerUnit      Int // price snapshot at time of booking
  // Line tables carried no timestamps at all until 2026-09-18, so "when was this
  // added to the order" was unanswerable — and admins do add lines days after a
  // booking is made.
  createdAt         DateTime        @default(now())
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  masterclassItem   MasterclassItem @relation(fields: [masterclassItemId], references: [id])
}

model OrderExtra {
  id        String   @id @default(cuid())
  orderId   String
  label     String
  amount    Int
  // See OrderMasterclass — an extra is the line most often added after the fact,
  // by an admin, which is exactly why this matters here.
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model WineOrder {
  id              String          @id @default(cuid())
  businessName    String
  llcName         String?
  llcId           String?
  address         String
  workingHours    String?
  contactName     String
  contactPhone    String
  // Optional in general; the wine order form requires it only when the tenant
  // has online payment on, since a paying B2B customer needs a receipt.
  contactEmail    String?
  totalAmount     Int?
  discountPercent Float?
  // Was an unconstrained String with no validation anywhere in the app or the
  // database — the root cause the whole status redesign was opened for. Now an
  // enum of its own: DELIVERED exists here and COMPLETED does not.
  stage           WineOrderStage  @default(NEW)
  // Milestone dates — see the equivalent block on Order for the reasoning.
  confirmedAt     DateTime?
  deliveredAt     DateTime?
  paidAt          DateTime?
  abandonedAt     DateTime?
  // ⚠️ DELIBERATELY UNWRITTEN FOR NOW. Added 2026-09-18 (Max's call) to close the
  // asymmetry with Order, which has had this column since Feature 191. There is
  // still no wine-order invoice-send flow, so **nothing writes this column yet** —
  // do not read it as "no invoice was sent", only as "we have no record either
  // way". The earlier reasoning for leaving it out was that a column nothing
  // writes is worse than an absent one, because the next reader assumes it is
  // populated; this comment is what pays that debt. Delete this warning the
  // moment a send flow starts writing it. See vault/DataModel/Plan-DataModel.md.
  invoiceSentAt   DateTime?
  tenantId        String?
  companyId       String?
  company         Company?        @relation(fields: [companyId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt
  wineItems       WineOrderItem[]
  payments        Payment[]
  events          OrderEvent[]
  // Same as Order.contacts — see the note there. The Contact Person's details are also mirrored
  // into contactName/contactPhone/contactEmail above, which the wine form requires and which
  // payment depends on.
  contacts        OrderContact[]

  // Mirrors Order: the board groups by stage, and the list's date-range
  // filters run on createdAt (wine orders have no separate business date).
  @@index([tenantId, stage])
  @@index([tenantId, createdAt])
  @@index([tenantId, abandonedAt])
}

/// One attempt to pay for an Order or a WineOrder through a payment gateway.
///
/// Rows are created at checkout time (status "created") and updated when the
/// gateway settles them. Deliberately a full record rather than a boolean on the
/// order: `rawResponse` is what lets a human reconcile against the gateway's own
/// portal when a callback fails, which is the only unrecoverable path in the
/// payment flow. It is also the landing spot for the 231 historical Flitt/TBC
/// transaction records from the old site, if that import ever happens.
model Payment {
  id                String        @id @default(cuid())
  tenantId          String?
  // Exactly one of these is set — a payment belongs to a booking or a wine
  // order, never both. Not expressible as a DB constraint in Prisma; enforced
  // at the call site in lib/payments/settle.ts.
  // Cascade, not the Prisma default. An optional relation defaults to SetNull,
  // which on an order delete would leave this row behind with both foreign keys
  // null — a real `amount` and a real `rawResponse`, attributable to nothing and
  // invisible to every screen. A payment has no meaning without its order, so it
  // goes when the order goes. See vault/DataModel/Dependencies.md finding 2.
  orderId           String?
  order             Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  wineOrderId       String?
  wineOrder         WineOrder?    @relation(fields: [wineOrderId], references: [id], onDelete: Cascade)
  /// Who processed it. "flitt" for a gateway payment, "manual" for one an
  /// admin recorded by hand.
  provider          String        @default("flitt")
  /// How the money actually moved (chunk 6, 2026-09-18).
  ///
  /// Payment used to be a Flitt attempt log: only card payments ever created a
  /// row. A company paying by bank transfer, cash on the day, or an admin
  /// correcting a mistake produced no row at all — the "mark as paid" button
  /// wrote `Order.paidAt` and nothing else. So `SUM(amount)` was card revenue
  /// while `paidAt IS NOT NULL` was all revenue, nothing reconciled the two,
  /// and nothing in the schema said so.
  ///
  /// Defaults to CARD because every row that existed before this column was a
  /// Flitt attempt. Hand-recorded payments land as MANUAL; there is no picker
  /// in the UI yet, so BANK_TRANSFER and CASH exist for when one is added
  /// rather than being guessed at on the admin's behalf.
  method            PaymentMethod @default(CARD)
  /// Set when an admin un-pays an order, instead of deleting the row.
  ///
  /// Only ever set on payments WE recorded (provider "manual"). A card payment
  /// that really settled is money the gateway is holding; marking that row
  /// reversed would misstate reality. Un-paying a gateway-paid order is an
  /// admin override, and the OrderEvent row is what records it.
  reversedAt        DateTime?
  providerPaymentId String?
  checkoutUrl       String?
  /// The gateway's own status string, stored verbatim (created/approved/declined/…).
  /// Not an enum: it belongs to the provider, and coercing it would lose detail
  /// that matters in a dispute.
  status            String        @default("created")
  amount            Int
  currency          String        @default("GEL")
  rawResponse       Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt
  settledAt         DateTime?

  /// The lookup key used by the callback handler. Unique per provider so a
  /// duplicate callback can never create a second row for the same payment.
  @@unique([provider, providerPaymentId])
  @@index([tenantId])
  @@index([orderId])
  @@index([wineOrderId])
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  CASH
  MANUAL
}

model Setting {
  id        String   @id @default(cuid())
  key       String
  value     String
  tenantId  String?
  updatedAt DateTime @updatedAt

  @@unique([key, tenantId])
  // The unique above can't serve a tenant lookup — tenantId is its trailing
  // column, and an index is only usable from its leading column onwards.
  // getAllSettings(tenantId) reads the whole per-tenant map on every request.
  @@index([tenantId])
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String
  value     String
  section   String
  label     String
  locale    String   @default("en")
  tenantId  String?
  updatedAt DateTime @updatedAt

  @@unique([key, locale, tenantId])
  // Same trailing-column problem as Setting. getAllContent(tenantId, locale)
  // is the hot path — every public page render goes through it.
  @@index([tenantId, locale])
}

model BlockedDate {
  id        String   @id @default(cuid())
  date      DateTime
  reason    String?
  tenantId  String?
  createdAt DateTime @default(now())

  @@unique([date, tenantId])
  @@index([tenantId, date])
}

model Wine {
  id           String        @id @default(cuid())
  name         String
  nameKa       String?
  wineType     WineType      @default(RED)
  sweetness    Sweetness     @default(DRY)
  sparkling    Boolean       @default(false)
  alcoholLevel Float?
  description  String?
  color        String        @default("#7c1d23")
  imagePath    String?
  active       Boolean       @default(true)
  sortOrder    Int           @default(0)
  tenantId     String?
  createdAt    DateTime      @default(now())
  vintages     WineVintage[]

  @@index([tenantId])
}

model WineVintage {
  id           String          @id @default(cuid())
  wineId       String
  year         Int
  price        Int
  imagePath    String?
  active       Boolean         @default(true)
  sortOrder    Int             @default(0)
  tenantId     String?
  createdAt    DateTime        @default(now())
  // Only meaningful when the tenant's wineDetailLevel is VINTAGE. No fallback
  // to the parent Wine's value when unset — an unset field means "not
  // specified", never a guess. sparkling is nullable (not default false) so
  // "unset" and "explicitly not sparkling" stay distinguishable.
  wineType     WineType?
  sweetness    Sweetness?
  sparkling    Boolean?
  alcoholLevel Float?
  wine         Wine            @relation(fields: [wineId], references: [id], onDelete: Cascade)
  orderItems   WineOrderItem[]

  @@index([tenantId])
  @@index([wineId])
}

model WineOrderItem {
  id                  String       @id @default(cuid())
  wineOrderId         String
  wineVintageId       String?
  wineNameSnapshot    String
  vintageYearSnapshot Int
  priceSnapshot       Int
  quantity            Int
  createdAt           DateTime     @default(now())
  wineOrder           WineOrder    @relation(fields: [wineOrderId], references: [id], onDelete: Cascade)
  wineVintage         WineVintage? @relation(fields: [wineVintageId], references: [id], onDelete: SetNull)
}

/// A bug report or feature request submitted via the floating report widget on
/// any surface (public site, tenant admin, super-admin). Deliberately modeled
/// on Tenant, not on the tenanted tables above: no `tenant` relation field and
/// no tenant_isolation RLS policy, since the super-admin inbox must read across
/// every tenant at once. `tenantId` is a plain nullable column filtered at the
/// application layer only — see RLS-Architecture.md's table list and
/// vault/Plan-BugReportWidget.md Phase 1.
model BugReport {
  id              String           @id @default(cuid())
  type            BugReportType
  status          BugReportStatus  @default(NEW)
  surface         BugReportSurface
  comment         String
  screenshotUrl   String?
  /// Capped ring buffer of the last ~25 clicks/navigations, e.g.
  /// [{type, target, path, timestamp}, ...]. See Plan-BugReportWidget.md Phase 2.
  breadcrumbs     Json?
  pageUrl         String
  userAgent       String?
  // Null for surfaces with no tenant context (public site pre-tenant-resolution
  // edge cases). No Prisma relation to Tenant, matching Payment/Order/etc. —
  // tenantId here is filtered in application code, not via RLS.
  tenantId        String?
  // Admin's email/Supabase auth user id if logged in; both null for anonymous
  // public-site submissions.
  submitterEmail  String?
  submitterUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([tenantId])
  @@index([status])
}

/// Where a booking is in its life, and nothing at all about money (Feature 191).
///
/// Its own enum rather than one shared with WineOrderStage. The two order types
/// agree on three of four words but differ on the fourth, and giving them one
/// shared vocabulary is what forced the previous design to carry an `appliesTo`
/// discriminator — which filtered the status *dropdown* but never the foreign
/// key, so nothing in the database actually stopped a booking being marked
/// DELIVERED. Two enums make that unrepresentable rather than merely unoffered.
///
/// Forward-only in the UI. CANCELLED is an exit from the flow, not the end of
/// it — see lib/statusFlow.ts.
enum BookingStage {
  NEW
  CONFIRMED
  COMPLETED
  CANCELLED
}

/// The wine-order equivalent. DELIVERED where a booking says COMPLETED; there is
/// deliberately no COMPLETED here and no DELIVERED there.
enum WineOrderStage {
  NEW
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum BookingType {
  INDIVIDUAL
  COMPANY
}

enum VisitType {
  TASTING
  TASTING_LUNCH
}

enum WineType {
  RED
  WHITE
  AMBER
  ROSE
}

enum Sweetness {
  DRY
  SEMI_DRY
  SEMI_SWEET
  SWEET
}

/// One thing a visitor did on demo.vineworks.ge.
///
/// Added 2026-09-12 (Plan-DemoFlowFixes' second deferred item). Every conversion
/// figure that shaped the demo's design — the tour's length, the feature list,
/// the front door's four paths — came from a vendor's blog, not from this site:
/// see Research-DemoPatterns.md's Caveat. This table is what turns those
/// benchmarks into measurements.
///
/// **Why our own table rather than an analytics product:** the Vercel team is on
/// Hobby, where Web Analytics has no custom events at all and a one-month
/// reporting window — page views that evaporate before a quarter is out, which
/// is the opposite of what a "did the demo convert" question needs. A third
/// party would have meant an external script, prospect traffic leaving the
/// building, and a cookie-consent banner on a public EU-facing sales demo. This
/// costs nothing, keeps everything first-party, uses no cookies, and retains
/// forever.
///
/// **Deliberately holds no personal data.** No IP, no user agent, no name, no
/// email — `sessionId` is a random per-tab string from sessionStorage that dies
/// with the tab and identifies nobody. `props` carries only small non-identifying
/// detail (which front-door path, which tour step, which capability row).
///
/// **The nightly reseed does not touch this table** (lib/demoSeed.ts deletes
/// Payment/Order/WineOrder/Company/MenuItem/MasterclassItem only), so a
/// "booking placed" event outlives the booking row it describes — which is the
/// point: the row is demo furniture, the event is the measurement.
///
/// RLS follows the standard checklist (RLS-Architecture.md) even though this
/// tenant is a fixed, known, publicly writable sandbox. The demo's threat model
/// genuinely is different, but a table that opts out is a table someone has to
/// remember is special; consistency is cheaper than the exception.
model DemoEvent {
  id        String   @id @default(cuid())
  /// Always the demo tenant — the server action refuses anything else. Present
  /// for RLS and so the table needs no special case in setup-rls.ts.
  tenantId  String
  /// A fixed vocabulary, defined in lib/demoAnalytics.ts. Kept as a String
  /// rather than an enum so adding one is not a migration.
  name      String
  /// Small, non-identifying detail: { path: 'winery' }, { step: 4 }.
  props     Json?
  /// Where it fired. Null for events with no single route.
  route     String?
  /// Random per-tab id (sessionStorage, not a cookie). Groups one visit's
  /// events together so a funnel is countable; identifies nobody.
  sessionId String
  createdAt DateTime @default(now())

  @@index([tenantId, name, createdAt])
  @@index([tenantId, sessionId])
}

enum WineDetailLevel {
  PRODUCT
  VINTAGE
}

enum MasterclassUnit {
  PER_PERSON // multiplied by paying guest count automatically
  PER_PIECE // admin enters quantity manually
  FLAT // fixed price, no quantity
}

enum BugReportType {
  BUG
  FEATURE
}

enum BugReportStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  WONT_FIX
}

enum BugReportSurface {
  PUBLIC_SITE
  ADMIN
  SUPER_ADMIN
}
